@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@using TracePoint.Shared
@inject NavigationManager Navigation
@implements IAsyncDisposable

<MudText Typo="Typo.h4" GutterBottom="true" Class="mb-4">TracePoint Live Analysis</MudText>

<MudGrid>
    @* Kartica za številko *@
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="3" Style="height: 100%">
            <MudText Typo="Typo.h6">Zadnja vrednost</MudText>
            <MudText Typo="Typo.h2" Color="Color.Primary">@(_lastMeasurement?.Value.ToString("F2") ?? "0.00")</MudText>
            <MudDivider Class="my-2"/>
            <MudText Typo="Typo.body2">CAN ID: <b>0x@(_lastMeasurement?.CanId.ToString("X") ?? "000")</b></MudText>
            <MudText Typo="Typo.body2">Kanal: @_lastMeasurement?.Channel</MudText>
        </MudPaper>
    </MudItem>

    @* Kartica za graf *@
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="3">
            <PlotlyChart @bind-Config="_config" @bind-Layout="_layout" @bind-Data="_data" @ref="_chart" />
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private HubConnection? _hubConnection;
    private CanMeasurementDto? _lastMeasurement;
    
    private PlotlyChart? _chart;
    private Config _config = new() { Responsive = true };
    private Layout _layout = new() { 
        Title = new() { Text = "CAN Signal Real-time" },
        YAxis = new List<YAxis> { new() { Title = new() { Text = "Vrednost" } } },
        XAxis = new List<XAxis> { new() { Title = new() { Text = "Čas" } } }
    };
    
    // Ključno: X in Y morata biti inicializirana kot prazni listi!
    private IList<ITrace> _data = new List<ITrace> { 
        new Scatter { 
            Name = "Signal", 
            Mode = ModeFlag.Lines | ModeFlag.Markers,
            X = new List<object>(),
            Y = new List<object>()
        } 
    };

    protected override async Task OnInitializedAsync()
    {
        // PAZI: Preveri port (5247 ali 7126?), ki ga izpiše API za HTTP!
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("http://localhost:5247/telemetryHub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<CanMeasurementDto>("ReceiveMeasurement", async (measurement) =>
        {
            _lastMeasurement = measurement;
            
            // 1. Najprej posodobimo UI za številke
            await InvokeAsync(StateHasChanged);

            if (_chart != null)
            {
                try 
                {
                    var xPos = DateTime.Now.ToString("HH:mm:ss.fff");
                    var yPos = measurement.Value;

                    // 1. Dodaj točko
                    await _chart.ExtendTrace(new List<object> { xPos }, new List<object> { yPos }, 0);

                    // 2. Če imamo več kot 50 točk, odreži začetek (Scroll effect)
                    // To naredimo z uporabo Relayout, da določimo vidno območje X osi
                    // Ali pa preprosto povemo Plotly-ju, naj obdrži le zadnjih 50 točk:
                    await _chart.ExtendTrace(new List<object> { xPos }, new List<object> { yPos }, 0, 50); 
                    // Četrty parameter (50) pove Plotly-ju: "Obdrži max 50 točk"
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Plotly Error: {ex.Message}");
                }
            }
        });

        try {
            await _hubConnection.StartAsync();
            Console.WriteLine("SignalR Povezan!");
        } catch (Exception ex) {
            Console.WriteLine($"SignalR Connection Error: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null) await _hubConnection.DisposeAsync();
    }
}